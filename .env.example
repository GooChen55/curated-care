# 复制为 .env，scripts/manage.py 会加载；Docker Compose 也读取根目录 .env。
DEMO_MODE=true
WEB_PORT=19080
DEMO_PASSWORD=Demo12345!
ADMIN_PASSWORD=Admin12345!
SERVICE_TOKEN=local-development-only
COMMERCE_URL=http://127.0.0.1:19081
ASSISTANT_URL=http://127.0.0.1:19082
KNOWLEDGE_URL=http://127.0.0.1:19083
# 可选：不配置时为明确标识的本地路由＋资料摘录模式。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus
# 可选：OpenAI 兼容 embedding，配置后新导入文档会生成向量。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
# 高级知识引擎另行部署并验证后启用；默认轻量检索。
ADVANCED_KNOWLEDGE_URL=
# 非演示部署需设置上面的管理员密码和服务令牌，并提供数据库连接。
# DB_URL=jdbc:mysql://127.0.0.1:3306/curated_care?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# DB_USER=curated_care
# DB_PASSWORD=
